    },
    "securitySchemes": {
      "TokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "token",
        "description": "Session token returned by `POST /login`, sent in the `token` header."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same session token sent as `Authorization: Bearer <token>`."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
