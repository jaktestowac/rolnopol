        ]
      },
      "MigrationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Operation success status"
          },
          "message": {
            "type": "string",
            "description": "Operation message"
          },
          "clearedCount": {
            "type": "integer",
